{
  "name": "viku",
  "productName": "Viku",
  "version": "0.1.0",
  "description": "Viku - Sermon Reel Studio desktop UI",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "mock:media": "node scripts/make-mock-media.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "dist": "npm run build && node scripts/fetch-uv.mjs && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && node scripts/fetch-uv.mjs && electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "1.65",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-oriya": "^5.3.0",
    "immer": "^11.2.10",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "author": "Viku"
}
