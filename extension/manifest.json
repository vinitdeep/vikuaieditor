{
  "manifest_version": 3,
  "name": "Viku – AI Studio pictures",
  "short_name": "Viku",
  "version": "0.2.3",
  "description": "Makes the pictures your Viku reels need in Google AI Studio, with your own signed-in Google account.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Viku", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "https://aistudio.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
